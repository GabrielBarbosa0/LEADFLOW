{
  "name": "leadflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --open",
    "dev": "vite",
    "dev:staging": "npm run verify:staging && vite --mode staging --host 0.0.0.0 --port 5175 --strictPort",
    "dev:emulator": "npm run verify:emulator && vite --mode emulator --host 0.0.0.0 --port 5176 --strictPort",
    "build": "vite build",
    "build:staging": "npm run verify:staging && vite build --mode staging",
    "build:pages": "vite build --base=/LEADFLOW/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-leadflow --config firebase.emulators.test.json --only firestore \"vitest run --config vitest.rules.config.js\"",
    "test:savwin-emulator": "firebase emulators:exec --project demo-leadflow --config firebase.emulators.test.json --only firestore \"vitest run --config vitest.integration.config.js\"",
    "verify:firebase": "npm run test:rules && node --check functions/index.js",
    "verify:staging": "node scripts/verify-staging-env.js",
    "verify:emulator": "node scripts/verify-emulator-env.js",
    "seed:emulator": "node scripts/seed-emulator.js",
    "seed:emulator:reset": "node scripts/seed-emulator.js --reset",
    "homolog:savwin-gateway": "node scripts/savwin-homolog-gateway.js",
    "verify:docker": "npm run test && npm run test:rules && npm run build:staging",
    "deploy:firebase": "npm run verify:firebase && firebase deploy --only firestore:rules",
    "deploy:firebase:full": "npm run verify:firebase && firebase deploy --only firestore:rules,functions",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate:captar": "node scripts/migrate-captar-schedule.js",
    "mark:captar-leads": "node scripts/mark-captar-leads.js",
    "migrate:appointment-services": "node scripts/migrate-appointment-services.js",
    "migrate:appointment-blocks": "node scripts/migrate-appointment-blocks.js",
    "sync:captar-team": "node scripts/sync-captar-team.js",
    "reset:team-passwords": "node scripts/reset-team-default-password.js",
    "emulators": "firebase emulators:start",
    "emulators:docker": "firebase emulators:start --only auth,firestore,functions --project demo-leadflow --config firebase.emulators.docker.json",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.31.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
